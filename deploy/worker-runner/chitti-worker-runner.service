[Unit]
Description=Chitti host-side sandbox worker runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chitti/app
EnvironmentFile=/etc/chitti/worker-runner.env
Environment=PYTHONPATH=/opt/chitti/app
RuntimeDirectory=chitti-worker
StateDirectory=chitti-worker
ExecStart=/usr/bin/python3 -m chitti.runner
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/chitti-worker
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
