[Unit]
Description=Chitti host-side sandbox worker runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chitti/app
EnvironmentFile=/etc/chitti/worker-runner.env
Environment=PYTHONPATH=/opt/chitti/app
Environment=CHITTI_CODE_IDENTITY_PATH=/run/chitti-worker/loaded-code.json
Environment=PREVIEW_ROOT=/var/lib/chitti-previews
Environment=PREVIEW_STAGING_ROOT=/var/lib/chitti-preview-staging
Environment=PREVIEW_TTL_HOURS=72
Environment=PREVIEW_MAX_BYTES=209715200
Environment=PREVIEW_MAX_COUNT=4
RuntimeDirectory=chitti-worker
StateDirectory=chitti-worker
ExecStart=/opt/chitti-runner/bin/python -m chitti.runner
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/chitti-worker /var/lib/chitti-previews /var/lib/chitti-preview-staging
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
