{
    order rate_limit before reverse_proxy
}

{$DOMAIN:localhost} {
    rate_limit {
        zone login {
            match {
                method POST
                path /login
            }
            key {remote_host}
            events 5
            window 1m
        }
    }
    reverse_proxy chitti:8000 {
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.scheme}
    }
}
